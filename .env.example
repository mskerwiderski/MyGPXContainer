# Copy to .env and adjust. Every setting is optional.

# Who signs in: single (one person, the default), local (several people with
# accounts of this app, invited by the admin) or myauth (an external MyAuth).
MGC_AUTH=single

# Port on the host.
MGC_PORT=8000

# Use the published images instead of building them here (then
# `docker compose pull`):
# MGC_IMAGE=ghcr.io/mskerwiderski/mygpxcontainer:latest
# MGC_ROUTING_IMAGE=ghcr.io/mskerwiderski/mygpxcontainer-routing:latest

# The code the first-start page asks for. Empty: a random one, in the log.
# MGC_SETUP_CODE=

# Behind a reverse proxy: the proxy's address (or * if only the proxy can
# reach the container), so sign-in limits see the real client address.
# FORWARDED_ALLOW_IPS=*

# Dates for people without their own time zone (IANA name).
MGC_TIMEZONE=Europe/Berlin

# Key for the stored Garmin access (Fernet, 32 bytes url-safe base64). Without
# it the app makes data/secret.key on first use. Make one with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# MGC_SECRET_KEY=

# Round-trip suggestions (optional, see README): start the routing service too
# and tell the app where it is.
# COMPOSE_PROFILES=routing
# MGC_ROUTING_URL=http://mygpxcontainer-routing:8989
# ROUTING_SERVE_HEAP=2g
# ROUTING_IMPORT_HEAP=4g

# Address search on /suggest (Photon, OpenStreetMap-based). The public
# instance of komoot has a fair-use policy; for heavy use run your own.
# MGC_PHOTON_URL=https://photon.komoot.io

# A line in the footer, e.g. who runs this instance.
# MGC_FOOTER_NOTE=

# Mode myauth only:
# MGC_AUTH_URL=http://myauth:8000
# MGC_AUTH_PUBLIC_PORT=1000
# MYAUTH_APP_KEY=
